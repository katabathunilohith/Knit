# ==========================================================
# Knit Client Environment Configuration
# ==========================================================

# (Optional) Real-world Authentication via Clerk
# Sign up at https://clerk.com (Free) and paste your Publishable Key here.
# If omitted, Knit automatically runs in Evaluator Mode with 1-click verified personas!
VITE_CLERK_PUBLISHABLE_KEY=

# (Optional) Custom WebSocket Server URL for production deployment (e.g. Render / Railway)
# If running locally, leave blank (defaults to ws://localhost:1234)
VITE_WS_URL=
